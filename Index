/* =========================================================
   TOAST
========================================================= */

function toast(message) {

    const el =
        document.getElementById(
            "toast"
        );


    el.textContent =
        message;


    el.classList.add("show");


    clearTimeout(
        window.greenLoopToast
    );


    window.greenLoopToast =
        setTimeout(() => {

            el.classList.remove(
                "show"
            );

        }, 2600);

}



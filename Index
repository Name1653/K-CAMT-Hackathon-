    }

};


function setLanguage(lang) {

    const t =
        translations[lang];


    const navButtons =
        document
            .querySelectorAll(
                ".navlinks button"
            );


    const pages = [
        "home",
        "food",
        "recycle",
        "transport",
        "used",
        "wallet"
    ];


    navButtons.forEach(
        (button, index) => {

            if (t[pages[index]]) {

                button.textContent =
                    t[pages[index]];

            }

        }
    );


    toast(
        lang === "th"
            ? "เปลี่ยนภาษาเป็นไทยแล้ว"
            : lang === "ko"
                ? "한국어로 변경되었습니다"
                : "Language changed to English"
    );

}



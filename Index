<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>GreenLoop — Sustainable Local Marketplace</title>

<style>
:root {
    --green: #16a36b;
    --green2: #0d7c52;
    --mint: #eafff5;
    --ink: #10241b;
    --muted: #6b7d74;
    --bg: #f5f8f6;
    --card: #ffffff;
    --line: #e5ece8;
    --yellow: #ffd95a;
    --red: #ff6b6b;
    --blue: #407de8;
    --shadow: 0 12px 35px rgba(16,36,27,.08);
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    background: var(--bg);
    color: var(--ink);
}

button,
input,
select {
    font: inherit;
}

button {
    cursor: pointer;
    border: 0;
}

button:disabled {
    cursor: not-allowed;
    opacity: .65;
}

/* =========================================================
   NAVIGATION
========================================================= */

.nav {
    height: 72px;
    background: #fff;
    border-bottom: 1px solid var(--line);

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 5%;

    position: sticky;
    top: 0;
    z-index: 100;
}

.logo {
    font-size: 22px;
    font-weight: 900;
    color: var(--green2);

    display: flex;
    align-items: center;
    gap: 9px;

    white-space: nowrap;
}

.logo span {
    background: var(--green);
    color: white;

    width: 34px;
    height: 34px;

    border-radius: 11px;

    display: grid;
    place-items: center;
}

.navlinks {
    display: flex;
    gap: 10px;
    align-items: center;
}

.navlinks button {
    background: none;
    color: #53665e;

    font-weight: 700;

    padding: 10px 12px;
    border-radius: 10px;
}

.navlinks button:hover,
.navlinks button.active {
    color: var(--green2);
    background: var(--mint);
}

.actions {
    display: flex;
    align-items: center;
    gap: 10px;
}

.credits {
    background: var(--mint);
    color: var(--green2);

    padding: 9px 13px;

    border-radius: 999px;

    font-weight: 850;
}

.lang {
    border: 1px solid var(--line);
    background: #fff;

    border-radius: 10px;

    padding: 8px 10px;
}

/* =========================================================
   PAGE SYSTEM
========================================================= */

.page {
    display: none;

    min-height: calc(100vh - 72px);

    animation: fadeIn .25s ease;
}

.page.active {
    display: block;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(8px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.container {
    max-width: 1280px;
    margin: auto;
    padding: 32px 5% 70px;
}

/* =========================================================
   COMMON
========================================================= */

.sectionHead {
    display: flex;
    justify-content: space-between;
    align-items: end;

    margin: 15px 0 18px;
}

.sectionHead h2 {
    margin: 0;
    font-size: 26px;
}

.sectionHead p {
    margin: 5px 0 0;

    color: var(--muted);
}

.viewall {
    background: none;
    color: var(--green2);
    font-weight: 850;
}

.grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
}

.card {
    background: var(--card);

    border: 1px solid var(--line);

    border-radius: 20px;

    overflow: hidden;

    box-shadow: var(--shadow);

    transition: .2s;
}

.card:hover {
    transform: translateY(-3px);
}

.pic {
    height: 160px;

    display: grid;
    place-items: center;

    font-size: 65px;

    background:
        linear-gradient(
            135deg,
            #dff8eb,
            #f7fff9
        );

    position: relative;
}

.tag {
    position: absolute;

    left: 12px;
    top: 12px;

    background: #fff;

    padding: 6px 9px;

    border-radius: 999px;

    font-size: 12px;

    font-weight: 900;

    color: var(--green2);
}

.cardbody {
    padding: 16px;
}

.cardbody h3 {
    margin: 0 0 7px;
    font-size: 17px;
}

.muted {
    color: var(--muted);
    font-size: 13px;
}

.price {
    margin-top: 12px;

    display: flex;
    align-items: center;
    gap: 8px;
}

.price strong {
    font-size: 21px;
}

.old {
    text-decoration: line-through;
    color: #9ba9a3;
}

.discount {
    color: #e04d4d;

    font-size: 12px;
    font-weight: 900;

    background: #fff0f0;

    padding: 5px 7px;

    border-radius: 7px;
}

.row {
    display: flex;

    justify-content: space-between;
    align-items: center;

    gap: 10px;

    margin-top: 13px;
}

.primary {
    background: var(--green);
    color: white;

    padding: 10px 13px;

    border-radius: 10px;

    font-weight: 800;
}

.primary:hover {
    background: var(--green2);
}

.secondary {
    background: var(--mint);
    color: var(--green2);

    padding: 10px 13px;

    border-radius: 10px;

    font-weight: 800;
}

/* =========================================================
   HOME
========================================================= */

.hero {
    display: grid;

    grid-template-columns: 1.35fr .65fr;

    gap: 24px;

    margin-bottom: 25px;
}

.heroMain {
    background:
        linear-gradient(
            135deg,
            #0d7c52,
            #18ad70
        );

    border-radius: 28px;

    padding: 42px;

    color: white;

    min-height: 340px;

    position: relative;

    overflow: hidden;
}

.heroMain::after {
    content: "🌱";

    position: absolute;

    right: 30px;
    bottom: -25px;

    font-size: 170px;

    opacity: .13;
}

.heroMain h1 {
    font-size: 48px;

    line-height: 1.03;

    margin: 0 0 15px;

    max-width: 650px;
}

.heroMain p {
    font-size: 18px;

    opacity: .9;

    max-width: 560px;
}

.search {
    margin-top: 28px;

    background: white;

    border-radius: 15px;

    padding: 5px;

    display: flex;

    max-width: 650px;
}

.search input {
    border: 0;
    outline: 0;

    flex: 1;

    padding: 13px 15px;

    color: var(--ink);

    background: transparent;
}

.search button {
    background: var(--green2);

    color: white;

    padding: 12px 18px;

    border-radius: 11px;
}

.wallet {
    background: #10241b;

    border-radius: 28px;

    padding: 30px;

    color: white;

    box-shadow: var(--shadow);
}

.wallet small {
    color: #b8cec4;
}

.wallet .big {
    font-size: 43px;

    font-weight: 900;

    margin: 12px 0;
}

.wallet .impact {
    background: #1a392d;

    padding: 15px;

    border-radius: 16px;

    margin-top: 22px;
}

.redeem {
    margin-top: 16px;

    width: 100%;

    background: var(--yellow);

    color: #1f2b22;

    padding: 13px;

    border-radius: 12px;

    font-weight: 900;
}

.quick {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 14px;

    margin-bottom: 32px;
}

.quick button {
    background: #fff;

    border: 1px solid var(--line);

    padding: 18px;

    border-radius: 18px;

    text-align: left;

    box-shadow: var(--shadow);

    transition: .2s;
}

.quick button:hover {
    transform: translateY(-3px);
}

.quick span {
    font-size: 25px;
}

.quick b {
    display: block;

    margin-top: 8px;
}

.featurePanel {
    background: white;

    border: 1px solid var(--line);

    border-radius: 24px;

    padding: 25px;

    box-shadow: var(--shadow);
}

.featureStats {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 15px;
}

.statBox {
    background: var(--mint);

    border-radius: 18px;

    padding: 20px;
}

.statBox strong {
    display: block;

    font-size: 30px;

    color: var(--green2);
}

.statBox span {
    color: var(--muted);

    font-size: 13px;
}

/* =========================================================
   HERO PAGE HEAD
========================================================= */

.pageHeader {
    background:
        linear-gradient(
            135deg,
            #0d7c52,
            #18ad70
        );

    color: white;

    border-radius: 25px;

    padding: 30px;

    margin-bottom: 25px;
}

.pageHeader h1 {
    margin: 0;

    font-size: 36px;
}

.pageHeader p {
    margin: 8px 0 0;

    opacity: .9;
}

/* =========================================================
   RIDE APP
========================================================= */

.rideApp {
    display: grid;

    grid-template-columns: 1.5fr .7fr;

    gap: 18px;

    background: white;

    padding: 14px;

    border-radius: 28px;

    border: 1px solid var(--line);

    box-shadow: var(--shadow);
}

.rideMap {
    height: 650px;

    position: relative;

    overflow: hidden;

    border-radius: 22px;

    background:
        linear-gradient(
            35deg,
            transparent 45%,
            #fff 46%,
            #fff 52%,
            transparent 53%
        ),
        linear-gradient(
            -20deg,
            transparent 43%,
            #fff 44%,
            #fff 51%,
            transparent 52%
        ),
        #dcefe4;
}

.rideMap::before {
    content: "";

    position: absolute;

    inset: 0;

    background:
        repeating-linear-gradient(
            90deg,
            transparent 0,
            transparent 100px,
            rgba(255,255,255,.35) 101px,
            rgba(255,255,255,.35) 103px
        );
}

.mapRoad {
    position: absolute;

    background: rgba(255,255,255,.85);

    border-radius: 999px;
}

.mapRoad.r1 {
    width: 120%;
    height: 28px;

    left: -10%;
    top: 42%;

    transform: rotate(-20deg);
}

.mapRoad.r2 {
    width: 120%;
    height: 24px;

    left: -10%;
    top: 65%;

    transform: rotate(28deg);
}

.userLocation {
    position: absolute;

    left: 30%;
    top: 65%;

    width: 44px;
    height: 44px;

    background: #1976ff;

    border: 4px solid #fff;

    border-radius: 50%;

    display: grid;
    place-items: center;

    z-index: 5;

    box-shadow:
        0 5px 20px rgba(0,0,0,.2);
}

.userPulse {
    position: absolute;

    width: 70px;
    height: 70px;

    background: rgba(25,118,255,.15);

    border-radius: 50%;

    animation: pulse 2s infinite;
}

@keyframes pulse {

    0% {
        transform: scale(.7);
        opacity: .8;
    }

    100% {
        transform: scale(1.4);
        opacity: 0;
    }

}

.evMarker {
    position: absolute;

    left: 63%;
    top: 20%;

    width: 54px;
    height: 54px;

    background: #10241b;

    border: 4px solid #fff;

    border-radius: 50%;

    display: grid;
    place-items: center;

    font-size: 24px;

    z-index: 10;

    box-shadow:
        0 7px 20px rgba(0,0,0,.25);

    transition:
        left 1s linear,
        top 1s linear;
}

.driverArrow {
    position: absolute;

    top: -18px;

    color: var(--green);

    font-size: 13px;
}

.mapDestination {
    position: absolute;

    left: 75%;
    top: 72%;

    width: 42px;
    height: 42px;

    background: #ff5757;

    color: white;

    border: 4px solid white;

    border-radius: 50%;

    display: grid;
    place-items: center;

    z-index: 5;
}

.mapETA {
    position: absolute;

    top: 20px;
    left: 20px;

    background: white;

    padding: 12px 16px;

    border-radius: 14px;

    box-shadow: var(--shadow);

    display: flex;
    flex-direction: column;
}

.mapETA strong {
    font-size: 20px;
}

.mapETA span {
    color: var(--muted);

    font-size: 12px;
}

.mapControls {
    position: absolute;

    right: 18px;
    bottom: 18px;

    display: flex;

    flex-direction: column;

    gap: 6px;
}

.mapControls button {
    width: 42px;
    height: 42px;

    background: white;

    border-radius: 12px;

    font-size: 20px;

    box-shadow: var(--shadow);
}

.ridePanel {
    padding: 20px;
}

.driverStatus {
    background: #f0fff7;

    color: var(--green2);

    padding: 12px;

    border-radius: 12px;

    font-weight: 800;

    margin-bottom: 20px;
}

.statusDot {
    display: inline-block;

    width: 9px;
    height: 9px;

    background: #16a36b;

    border-radius: 50%;

    margin-right: 6px;

    animation: statusPulse 1.2s infinite;
}

@keyframes statusPulse {

    50% {
        opacity: .3;
    }

}

.locationInput {
    display: flex;

    align-items: center;

    gap: 10px;

    border: 1px solid var(--line);

    padding: 13px;

    border-radius: 13px;

    background: #fafcfb;
}

.locationInput input {
    width: 100%;

    border: 0;

    outline: 0;

    background: transparent;
}

.locationLine {
    height: 20px;

    width: 2px;

    background: #d8e3de;

    margin-left: 20px;
}

.rideTitle {
    margin-top: 24px;
}

.vehicleOptions {
    display: flex;

    flex-direction: column;

    gap: 8px;
}

.vehicle {
    display: grid;

    grid-template-columns:
        40px
        1fr
        auto;

    align-items: center;

    gap: 10px;

    padding: 12px;

    border: 1px solid var(--line);

    border-radius: 14px;

    background: white;

    text-align: left;

    transition: .2s;
}

.vehicle:hover,
.vehicle.active {
    border: 2px solid var(--green);

    background: var(--mint);
}

.vehicleIcon {
    font-size: 25px;
}

.vehicle small {
    display: block;

    color: var(--muted);

    margin-top: 3px;
}

.rideInfo {
    margin-top: 18px;

    padding: 15px;

    background: #f5f8f6;

    border-radius: 15px;

    display: flex;

    justify-content: space-between;
}

.rideInfo small {
    display: block;

    color: var(--muted);
}

.rideInfo strong {
    display: block;

    font-size: 19px;

    margin-top: 3px;
}

.callRide {
    width: 100%;

    margin-top: 15px;

    padding: 15px;

    border-radius: 14px;

    background: var(--green);

    color: white;

    font-weight: 900;

    font-size: 16px;
}

.callRide:hover {
    background: var(--green2);
}

.driverCard {
    margin-top: 15px;

    display: flex;

    align-items: center;

    gap: 12px;

    padding: 14px;

    border: 1px solid var(--line);

    border-radius: 15px;
}

.driverAvatar {
    width: 45px;
    height: 45px;

    border-radius: 50%;

    background: var(--mint);

    display: grid;
    place-items: center;

    font-size: 23px;
}

.driverInfo {
    flex: 1;
}

.driverInfo span,
.driverInfo small {
    display: block;

    color: var(--muted);

    font-size: 12px;

    margin-top: 3px;
}

.driverActions {
    display: flex;

    gap: 5px;
}

.driverActions button {
    width: 35px;
    height: 35px;

    border-radius: 50%;

    background: var(--mint);
}

/* =========================================================
   RECYCLE
========================================================= */

.recycleBanner {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 18px;

    margin-bottom: 25px;
}

.recycleInfo {
    background: var(--mint);

    border-radius: 22px;

    padding: 25px;
}

.recycleInfo strong {
    display: block;

    color: var(--green2);

    font-size: 42px;
}

.recycleInfo span {
    color: var(--muted);
}

.earnBadge {
    background: #10241b;

    color: white;

    border-radius: 22px;

    padding: 25px;

    display: flex;

    flex-direction: column;

    justify-content: center;
}

/* =========================================================
   USED MARKETPLACE
========================================================= */

.marketToolbar {
    background: white;

    padding: 15px;

    border-radius: 17px;

    border: 1px solid var(--line);

    display: flex;

    gap: 10px;

    margin-bottom: 20px;
}

.marketToolbar input {
    flex: 1;

    border: 1px solid var(--line);

    padding: 11px 14px;

    border-radius: 11px;

    outline: none;
}

/* =========================================================
   WALLET
========================================================= */

.walletPage {
    display: grid;

    grid-template-columns:
        1fr
        1fr;

    gap: 20px;
}

.bigWallet {
    background: #10241b;

    color: white;

    border-radius: 25px;

    padding: 30px;
}

.bigWallet .number {
    font-size: 60px;

    font-weight: 950;

    margin: 15px 0;
}

.walletProgress {
    background: #1a392d;

    height: 14px;

    border-radius: 999px;

    overflow: hidden;

    margin-top: 20px;
}

.walletProgress div {
    width: 82%;

    height: 100%;

    background: var(--green);

    border-radius: 999px;
}

.rewardPanel {
    background: white;

    border: 1px solid var(--line);

    border-radius: 25px;

    padding: 25px;
}

.reward {
    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 10px;

    padding: 15px;

    background: var(--mint);

    border-radius: 15px;

    margin: 10px 0;
}

/* =========================================================
   ACTIVITY
========================================================= */

.activity {
    display: grid;

    grid-template-columns:
        1fr
        1fr;

    gap: 16px;
}

.panel {
    background: white;

    border: 1px solid var(--line);

    border-radius: 20px;

    padding: 20px;
}

.activityItem {
    display: flex;

    justify-content: space-between;

    padding: 14px 0;

    border-bottom: 1px solid var(--line);
}

.activityItem:last-child {
    border: 0;
}

.plus {
    color: var(--green);

    font-weight: 900;
}

/* =========================================================
   FOOTER
========================================================= */

.footer {
    background: #10241b;

    color: #d7e7df;

    padding: 35px 5%;

    display: flex;

    justify-content: space-between;

    align-items: center;
}

.footer b {
    color: white;
}

/* =========================================================
   MODAL
========================================================= */

.modal {
    position: fixed;

    inset: 0;

    background: rgba(10,25,18,.5);

    display: none;

    place-items: center;

    z-index: 200;

    padding: 20px;
}

.modal.show {
    display: grid;
}

.modalbox {
    background: white;

    width: min(520px,100%);

    border-radius: 24px;

    padding: 25px;
}

.modalhead {
    display: flex;

    justify-content: space-between;

    gap: 20px;
}

.close {
    background: #eef4f1;

    border-radius: 50%;

    width: 34px;

    height: 34px;

    flex-shrink: 0;
}

/* =========================================================
   TOAST
========================================================= */

.toast {
    position: fixed;

    right: 22px;
    bottom: 22px;

    background: #10241b;

    color: white;

    padding: 14px 18px;

    border-radius: 13px;

    box-shadow: var(--shadow);

    transform: translateY(120px);

    transition: .3s;

    z-index: 300;
}

.toast.show {
    transform: translateY(0);
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:1100px) {

    .grid {
        grid-template-columns: repeat(2,1fr);
    }

    .navlinks {
        gap: 2px;
    }

    .navlinks button {
        padding: 8px;
        font-size: 13px;
    }

}

@media(max-width:900px) {

    .navlinks {
        display: none;
    }

    .hero {
        grid-template-columns: 1fr;
    }

    .quick {
        grid-template-columns: repeat(2,1fr);
    }

    .rideApp {
        grid-template-columns: 1fr;
    }

    .rideMap {
        height: 480px;
    }

    .walletPage {
        grid-template-columns: 1fr;
    }

    .recycleBanner {
        grid-template-columns: 1fr;
    }

    .activity {
        grid-template-columns: 1fr;
    }

}

@media(max-width:560px) {

    .nav {
        padding: 0 4%;
    }

    .container {
        padding-left: 4%;
        padding-right: 4%;
    }

    .grid {
        grid-template-columns: 1fr;
    }

    .quick {
        grid-template-columns: 1fr 1fr;
    }

    .heroMain {
        padding: 28px;
    }

    .heroMain h1 {
        font-size: 34px;
    }

    .wallet .big {
        font-size: 36px;
    }

    .heroMain p {
        font-size: 16px;
    }

    .featureStats {
        grid-template-columns: 1fr;
    }

    .rideMap {
        height: 400px;
    }

    .ridePanel {
        padding: 12px;
    }

    .walletPage .bigWallet .number {
        font-size: 45px;
    }

    .marketToolbar {
        flex-direction: column;
    }

    .footer {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
    }

}
</style>
</head>


<body>

<!-- =========================================================
     NAV
========================================================= -->

<nav class="nav">

    <div class="logo">
        <span>🌱</span>
        GreenLoop
    </div>

    <div class="navlinks">

        <button
            class="active"
            data-page="home"
            onclick="showPage('home',this)">
            Home
        </button>

        <button
            data-page="food"
            onclick="showPage('food',this)">
            Food Deals
        </button>

        <button
            data-page="recycle"
            onclick="showPage('recycle',this)">
            Recycle
        </button>

        <button
            data-page="transport"
            onclick="showPage('transport',this)">
            Green Ride
        </button>

        <button
            data-page="used"
            onclick="showPage('used',this)">
            Used Items
